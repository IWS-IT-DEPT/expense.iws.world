# ---------------------------------------------------------------------------
# Copy to .env.local for development. Set the real values in the Vercel
# project (Settings -> Environment Variables) for preview + production.
# ---------------------------------------------------------------------------

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the app (used for OAuth redirects)
APP_URL="http://localhost:3000"

# Microsoft Entra ID (M365 SSO)
#   App registration redirect URI: {APP_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Tenant-locked issuer (NOT "common") — this is what restricts login to your org:
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"
# Comma-separated UPN domains allowed to sign in (all IWS staff are @iws.world)
ALLOWED_EMAIL_DOMAINS="iws.world"

# Role sync from Entra groups. Set BOTH to the group Object Ids to activate:
#   IT@iws.world          -> admin (full backend management)
#   IWS-Finance@iws.world -> accounting (review / imports / exports)
#
# Membership is read two ways (token claim first, Graph as fallback):
#  1. groups CLAIM: app registration -> Token configuration -> Add groups claim
#     -> "Groups assigned to the application", ID token checked; then assign both
#     groups to the app under Enterprise applications -> Users and groups.
#  2. Graph FALLBACK (covers overage / missing claim): add the *application*
#     permission Microsoft Graph -> GroupMember.Read.All, grant admin consent.
#     Uses AUTH_MICROSOFT_ENTRA_ID_ID/SECRET + tenant from the issuer.
ENTRA_GROUP_IT=""
ENTRA_GROUP_FINANCE=""
# Break-glass admins, always admin regardless of group membership (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=""

# Receipt storage: "local" (default, writes to ./.data) or "vercel"
STORAGE_DRIVER="local"
# Auto-injected by Vercel when you create a Blob store; only needed when STORAGE_DRIVER=vercel
BLOB_READ_WRITE_TOKEN=""
# Max size per uploaded receipt file, in MB (default 10). The scanner keeps its
# output well under this; raise it only if people upload large PDFs.
RECEIPT_MAX_MB="10"

# QuickBooks Online (Phase 2 — leave blank until wiring the integration)
QBO_ENV="sandbox"           # sandbox | production
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# 32-byte base64 key for encrypting stored QBO refresh tokens
QBO_TOKEN_ENC_KEY=""

# Email (Resend) — weekly-report reminders. Unset = reminders are logged, not sent.
RESEND_API_KEY=""
MAIL_FROM="expense@iws.world"

# Weekly-report reminder cron. Sends Wed morning / Fri morning / Fri afternoon
# in APP_TZ to anyone who hasn't filed. Vercel cron is UTC-only, so vercel.json's
# schedules are tuned for US Central daylight time (exact Mar–Nov, ~1h early in
# winter). Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically.
CRON_SECRET=""
APP_TZ="America/Chicago"
